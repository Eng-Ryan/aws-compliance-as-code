<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Compliance Report — {{ run_id }}</title>
  <style>
    :root { color-scheme: light dark; }
    body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; max-width: 960px; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
    h1 { font-size: 1.5rem; }
    .summary { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1.5rem 0; }
    .summary .card { border: 1px solid #8883; border-radius: 8px; padding: 0.75rem 1rem; min-width: 120px; }
    .card .num { font-size: 1.6rem; font-weight: 700; }
    .score { font-size: 2rem; font-weight: 700; }
    table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    th, td { text-align: left; padding: 0.5rem 0.6rem; border-bottom: 1px solid #8883; font-size: 0.9rem; vertical-align: top; }
    th { text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.03em; opacity: 0.7; }
    .status-pass { color: #1a7f37; font-weight: 600; }
    .status-fail { color: #cf222e; font-weight: 600; }
    .status-error { color: #9a6700; font-weight: 600; }
    .status-not_applicable { opacity: 0.6; }
    .sev-critical { border-left: 4px solid #cf222e; }
    .sev-high { border-left: 4px solid #bc4c00; }
    .sev-medium { border-left: 4px solid #9a6700; }
    .sev-low { border-left: 4px solid #57606a; }
    .remediation { font-size: 0.85rem; opacity: 0.85; margin-top: 0.25rem; }
    footer { margin-top: 2.5rem; font-size: 0.8rem; opacity: 0.6; }
  </style>
</head>
<body>
  <h1>Compliance Report</h1>
  <p>Run ID: <code>{{ run_id }}</code> &nbsp;|&nbsp; Generated: {{ generated_at }} &nbsp;|&nbsp; Frameworks: {{ frameworks|join(", ") }}</p>

  <div class="summary">
    <div class="card"><div class="num score">{{ summary.compliance_score_pct }}%</div>Compliance score</div>
    <div class="card"><div class="num">{{ summary.total_controls }}</div>Total controls</div>
    <div class="card"><div class="num" style="color:#1a7f37">{{ summary.passed }}</div>Passed</div>
    <div class="card"><div class="num" style="color:#cf222e">{{ summary.failed }}</div>Failed</div>
    <div class="card"><div class="num" style="color:#9a6700">{{ summary.errored }}</div>Errors</div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Control</th>
        <th>Framework</th>
        <th>Severity</th>
        <th>Status</th>
        <th>Finding</th>
      </tr>
    </thead>
    <tbody>
      {% for r in results %}
      <tr class="sev-{{ r.severity }}">
        <td><strong>{{ r.control_id }}</strong><br><span style="opacity:0.7">{{ r.title }}</span></td>
        <td>{{ r.framework }}</td>
        <td>{{ r.severity }}</td>
        <td class="status-{{ r.status }}">{{ r.status|upper }}</td>
        <td>
          {{ r.message }}
          {% if r.remediation %}
          <div class="remediation"><strong>Remediation:</strong> {{ r.remediation }}</div>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <footer>
    Generated by the compliance-as-code engine. Evidence for every control above is hashed
    (SHA-256) and stored alongside this report — see the manifest for this run.
  </footer>
</body>
</html>
